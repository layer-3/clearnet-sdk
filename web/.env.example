# Yellow web app settings. All values are read at build time.

# JSON array of networks available in the app.
#   slug       URL-safe id used for routing and storage ("testnet")
#   name       Display name ("Testnet")
#   gateway    Public gateway base URL; use http://127.0.0.1:8080 for local clearbox
#   networkId  Four-character Clearnet network ID (YNET, YTES, YDEV)
#   proxy      Optional. true routes requests through this site's /api/gw proxy
#              (use when the gateway does not send CORS headers)
#   fingerprint Optional. SHA-256 trust fingerprint, same value `yellow network show` prints.
#              When set, the app refuses to sign if the gateway identity changes.
#   rpcUrl     Optional. JSON-RPC URL wallets use for the Yellow chain (defaults to <gateway>/rpc)
#   explorer   Optional. Block explorer base URL
NEXT_PUBLIC_YELLOW_NETWORKS='[{"slug":"local","name":"Local","gateway":"http://127.0.0.1:8080","networkId":"YDEV","proxy":true}]'

# Slug of the network selected on first visit. Defaults to the first entry.
NEXT_PUBLIC_YELLOW_DEFAULT_NETWORK=local

# Reown (WalletConnect) project ID from https://dashboard.reown.com
NEXT_PUBLIC_REOWN_PROJECT_ID=

# App origin, used for wallet metadata (optional)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
